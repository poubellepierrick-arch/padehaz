rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidWorkshop(data) {
      return data.keys().hasAll(['ownerId', 'updatedAt']) &&
             data.keys().hasOnly([
               'ownerId',
               'name',
               'allStates',
               'currentGroupName',
               'globalAlgoTemplates',
               'globalProgEmbed',
               'updatedAt',
               'dataJson'
             ]) &&
             data.ownerId is string &&
             data.ownerId.size() > 0 &&
             data.ownerId.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             data.updatedAt is string &&
             data.updatedAt.size() > 0 &&
             data.updatedAt.size() <= 64 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
             (!('currentGroupName' in data) || (data.currentGroupName is string && data.currentGroupName.size() <= 120)) &&
             (!('globalProgEmbed' in data) || (data.globalProgEmbed is string && data.globalProgEmbed.size() <= 2000)) &&
             (!('allStates' in data) || data.allStates is map) &&
             (!('globalAlgoTemplates' in data) || (data.globalAlgoTemplates is list && data.globalAlgoTemplates.size() <= 100)) &&
             (!('dataJson' in data) || (data.dataJson is string && data.dataJson.size() <= 900000));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'updatedAt']) &&
             data.keys().hasOnly(['displayName', 'updatedAt']) &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 120 &&
             data.updatedAt is string &&
             data.updatedAt.size() > 0 &&
             data.updatedAt.size() <= 64;
    }

    match /workshops/{workshopId} {
      allow get: if isSignedIn() &&
                 isValidId(workshopId) &&
                 (workshopId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
                    isValidId(workshopId) &&
                    isValidWorkshop(incoming()) &&
                    workshopId == request.auth.uid;
      allow update: if isVerifiedUser() &&
                    isValidId(workshopId) &&
                    isValidWorkshop(incoming()) &&
                    workshopId == request.auth.uid &&
                    (!('ownerId' in existing()) || (existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId)) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'ownerId',
                      'name',
                      'allStates',
                      'currentGroupName',
                      'globalAlgoTemplates',
                      'globalProgEmbed',
                      'updatedAt',
                      'dataJson'
                    ]);
      allow delete: if isVerifiedUser() &&
                    isValidId(workshopId) &&
                    (workshopId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isVerifiedUser() &&
                    isValidId(userId) &&
                    userId == request.auth.uid &&
                    isValidUserProfile(incoming());
      allow update: if isVerifiedUser() &&
                    isValidId(userId) &&
                    userId == request.auth.uid &&
                    isValidUserProfile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
    }
  }
}
